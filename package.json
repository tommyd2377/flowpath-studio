{
  "name": "voice-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/platform-ui"
  ],
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3220",
    "build": "next build",
    "build:platform": "npm run build --workspace @thevoice/platform-ui",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts && node --import tsx --test tests/presentation/*.test.ts",
    "test:package": "npm run build:platform && node scripts/verify-platform-package.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:recorder": "node scripts/test-recorder.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3220",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:package && npm run build",
    "pretest": "npm run build:platform",
    "predev": "node scripts/check-node.mjs && npm run build:platform",
    "prestart": "node scripts/check-node.mjs",
    "prebuild": "node scripts/check-node.mjs && npm run build:platform",
    "pretypecheck": "node scripts/check-node.mjs && npm run build:platform",
    "precheck": "node scripts/check-node.mjs"
  },
  "dependencies": {
    "@thevoice/platform-ui": "0.1.0",
    "pdfjs-dist": "6.3.289",
    "firebase": "12.18.0",
    "firebase-admin": "14.3.0",
    "lucide-react": "1.41.0",
    "motion": "13.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "ws": "8.21.3",
    "zod": "4.4.3",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "tsx": "4.23.13",
    "@types/node": "24.3.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/ws": "8.18.1",
    "eslint": "9.38.0",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
