{
  "name": "voice-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3220",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3220",
    "start:hosting": "next start --hostname 0.0.0.0",
    "lint": "eslint app components lib tests scripts playwright.config.ts playwright.paid.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:browser:paid": "playwright test --config playwright.paid.config.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "predev": "node scripts/check-node.mjs",
    "prebuild": "node scripts/check-node.mjs",
    "prestart": "node scripts/check-node.mjs"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "google-auth-library": "11.3.1",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/ws": "8.18.1",
    "eslint": "9.38.0",
    "eslint-config-next": "16.3.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
