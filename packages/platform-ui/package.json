{
  "name": "@thevoice/platform-ui",
  "version": "0.1.0",
  "type": "module",
  "files": ["dist"],
  "sideEffects": ["**/*.css", "./dist/openui-compat.js"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./contracts": { "types": "./dist/contracts.d.ts", "import": "./dist/contracts.js" },
    "./catalog": { "types": "./dist/catalog.d.ts", "import": "./dist/catalog.js" },
    "./knowledge": { "types": "./dist/knowledge.d.ts", "import": "./dist/knowledge.js" },
    "./workspace": { "types": "./dist/workspace.d.ts", "import": "./dist/workspace.js" },
    "./interaction": { "types": "./dist/interaction.d.ts", "import": "./dist/interaction.js" },
    "./media": { "types": "./dist/media.d.ts", "import": "./dist/media.js" },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": { "build": "tsc -p tsconfig.json && node build.mjs", "prepack": "npm run build" },
  "peerDependencies": { "react": "^19.0.0", "react-dom": "^19.0.0" },
  "dependencies": { "@openuidev/react-lang": "0.2.15", "motion": "13.2.0", "zod": "4.4.3" }
}
